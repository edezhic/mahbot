{
  "heading_levels": [1, 2, 3],
  "scalar_kinds": ["string", "number", "boolean"],
  "image_extensions": ["png", "jpg", "jpeg"],
  "image_side_px": { "min": 1, "max": 20000, "min_exclusive": false },
  "pdf_size_points": { "min": 0, "max": 20000, "min_exclusive": true },
  "text_size_points": { "min": 0.5, "max": 819, "min_exclusive": false },
  "paragraph_alignments": [["left", "left"], ["center", "center"], ["right", "right"], ["justify", "both"]],
  "paragraph_lists": [["bullet", "bullet"], ["number", "decimal"]],
  "paragraph_indent_points": { "min": -2000, "max": 2000, "min_exclusive": false },
  "paragraph_spacing_points": { "min": 0, "max": 2000, "min_exclusive": false },
  "paragraph_line_points": { "min": 0.05, "max": 2000, "min_exclusive": false },
  "paragraph_style_max": 64,
  "slide_text_size_points": { "min": 1, "max": 4000, "min_exclusive": false },
  "cell_font_points": { "min": 1, "max": 409, "min_exclusive": false },
  "column_width_chars": { "min": 0, "max": 255, "min_exclusive": false },
  "row_height_points": { "min": 0, "max": 409, "min_exclusive": false },
  "pdf_point_abs_max": 20000,
  "color_digits": 6,
  "slide_alignments": [["left", "l"], ["center", "ctr"], ["right", "r"], ["justify", "just"]],
  "cell_alignments": ["general", "left", "center", "right", "justify", "distributed", "centerContinuous"],
  "cell_verticals": ["top", "center", "bottom", "justify", "distributed"],
  "cell_border_sides": ["top", "bottom", "left", "right"],
  "degrees_step": 90,
  "sheet_name_max": 31,
  "sheet_name_forbidden": "[]:*?/\\",
  "slide_position_fraction": { "min": 0, "max": 1, "min_exclusive": false },
  "slide_size_fraction": { "min": 0, "max": 1, "min_exclusive": true },
  "ppt_marks": {
    "title": "(title)",
    "hidden_slide": "(hidden slide)",
    "diagram_text": "(diagram text)",
    "diagram_text_lost": "(diagram text could not be read)",
    "no_text": "(no text)"
  },
  "ppt_slide_labels": {
    "slide": "Slide {n}:",
    "notes": "Slide {n} notes:"
  },
  "docx_peripheral_parts": [
    { "kind": "header", "rel": "/header", "phrase": "a header" },
    { "kind": "footer", "rel": "/footer", "phrase": "a footer" },
    { "kind": "footnote", "rel": "/footnotes", "phrase": "a footnote", "part": "word/footnotes.xml" },
    { "kind": "endnote", "rel": "/endnotes", "phrase": "an endnote", "part": "word/endnotes.xml" },
    { "kind": "comment", "rel": "/comments", "phrase": "a comment", "part": "word/comments.xml" }
  ],
  "docx_marks": [
    { "pattern": "\\[text box\\]", "example": "[text box]" },
    { "pattern": "\\[ins\\]", "example": "[ins]" },
    { "pattern": "\\[/ins\\]", "example": "[/ins]" },
    { "pattern": "\\[del\\]", "example": "[del]" },
    { "pattern": "\\[/del\\]", "example": "[/del]" },
    { "pattern": "\\[moved-here\\]", "example": "[moved-here]" },
    { "pattern": "\\[/moved-here\\]", "example": "[/moved-here]" },
    { "pattern": "\\[moved-away\\]", "example": "[moved-away]" },
    { "pattern": "\\[/moved-away\\]", "example": "[/moved-away]" },
    { "pattern": "\\[ins ¶\\]", "example": "[ins ¶]" },
    { "pattern": "\\[del ¶\\]", "example": "[del ¶]" },
    { "pattern": "\\[moved-here ¶\\]", "example": "[moved-here ¶]" },
    { "pattern": "\\[moved-away ¶\\]", "example": "[moved-away ¶]" },
    { "pattern": "\\[fmt\\]", "example": "[fmt]" },
    { "pattern": "\\[fmt ¶\\]", "example": "[fmt ¶]" },
    { "pattern": "\\[fmt section\\]", "example": "[fmt section]" },
    { "pattern": "\\[field[^\\]]*\\]", "example": "[field PAGE \\* MERGEFORMAT]" },
    { "pattern": "\\[(?:footnote|endnote|comment) (?:\\d+|\\?)(?: starts| ends)?\\]", "example": "[comment 1 starts]" },
    { "pattern": "Table \\d+(?: \\(formatting revised\\))?:", "example": "Table 1 (formatting revised):" },
    { "pattern": "(?:R\\d+|C\\d+)(?: \\([^)]*\\))?:", "example": "C2:" },
    { "pattern": "\\(spans C\\d+-C\\d+\\)", "example": "(spans C2-C4)" },
    { "pattern": "\\(part of R\\d+C\\d+\\)", "example": "(part of R3C2)" },
    { "pattern": "\\((?:inserted|deleted|merge revised|formatting revised)\\)", "example": "(merge revised)" },
    { "pattern": "(?:Footnote|Endnote|Comment) \\d+(?: \\([^)]*\\))?:", "example": "Footnote 1 (not referenced in the text):" },
    { "pattern": "(?:Header|Footer)(?: \\d+)? \\([^)]*\\):", "example": "Header 1 (first page):" },
    { "pattern": "Unaccepted tracked changes:", "example": "Unaccepted tracked changes: 1 insertion" },
    { "pattern": "\\(authors: [^)]*\\)", "example": "(authors: Anna)" }
  ],
  "edit_text_max": 20000,
  "edits_max": 200,
  "bullets_max": 100,
  "paragraph_level_max": 8,
  "sheet_row_max": 1048576,
  "sheet_column_max": 16384,
  "number_format_max": 200,
  "font_name_max": 31,
  "format_cells_max": 10000
}
